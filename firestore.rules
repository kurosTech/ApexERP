rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Default rule: Allow read and write for authenticated users in the ERP
    // In demo / single-tenant deployment or initial workspace, allow read/write to authenticated or all users
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
